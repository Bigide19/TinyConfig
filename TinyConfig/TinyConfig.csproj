<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net461</TargetFrameworks>
    <LangVersion>7.3</LangVersion>

    <!-- NuGet Package -->
    <PackageId>TinyConfig</PackageId>
    <Version>1.3.0</Version>
    <Authors>Bigide19</Authors>
    <Description>The simplest way to manage INI, JSON, XML, and Registry settings for .NET. No package dependencies on .NET Framework.</Description>
    <PackageTags>config;ini;json;xml;registry;settings;configuration</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Bigide19/TinyConfig</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Bigide19/TinyConfig</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinyConfig.Tests" />
  </ItemGroup>

  <!-- .NET Framework 는 Registry 와 Xml 이 내장입니다. JSON 은 자체 파서라 어느 타깃에서도 패키지가 필요 없습니다. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
