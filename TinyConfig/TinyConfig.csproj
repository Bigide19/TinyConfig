<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>

    <!-- NuGet Package -->
    <PackageId>TinyConfig</PackageId>
    <Version>1.0.0</Version>
    <Authors>Bigide19</Authors>
    <Description>The simplest way to manage INI, JSON, XML, and Registry settings for .NET.</Description>
    <PackageTags>config;ini;json;xml;registry;settings;configuration</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Bigide19/TinyConfig</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Bigide19/TinyConfig</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinyConfig.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
