<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net461 is past end of support but kept for apps still targeting 4.6.1. -->
    <TargetFrameworks>netstandard2.0;net461;net462;net47;net471;net472;net48;net481;net8.0;net10.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>

    <!-- NuGet Package -->
    <PackageId>TinyConfig</PackageId>
    <Version>1.4.0</Version>
    <Authors>Bigide19</Authors>
    <Description>The simplest way to manage INI, JSON, XML, and Registry settings for .NET. No package dependencies on .NET Framework.</Description>
    <PackageTags>config;ini;json;xml;registry;settings;configuration</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Bigide19/TinyConfig</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Bigide19/TinyConfig</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinyConfig.Tests" />
  </ItemGroup>

  <!-- Registry ships with .NET Framework and .NET 5+; only netstandard2.0 needs the package. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
